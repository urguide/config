{{/* Trusted accounts that may receive secrets. Defined once so the two
     guards below can never drift apart. */}}
{{- $trusted := has .chezmoi.username (list "tom" "tomchi") -}}

# ===== Windows: ignore everything, then whitelist =====
# Note: "dir/**" also matches "dir" itself, and once a directory is ignored
# chezmoi does not descend into it, so every wanted parent must be un-ignored.
# Note: "!" excludes are global and beat ALL ignores regardless of order,
# so the secret whitelist below must stay inside the username guard.
{{ if eq .chezmoi.os "windows" }}
*
**
!AppData
!AppData/**
!Documents
!Documents/PowerShell
!Documents/PowerShell/**
!Documents
!Documents/WindowsPowerShell
!Documents/WindowsPowerShell/**
{{ if $trusted }}
!.ssh
!.ssh/config
!.git-credentials
!.config
!.config/rclone
!.config/rclone/rclone.conf
{{ end }}
{{ else }}
AppData
AppData/**
Documents
Documents/**
Documents
Documents/**
{{ end }}

{{ if not $trusted }}
.cli-proxy-api
.cli-proxy-api/config.yaml
.config/starship.toml
.config/systemd
.config/rclone
.config/mykey.env.age
.git-credentials.age
.myshellrc
.ssh/config.age
.tmux.conf
{{ end }}
