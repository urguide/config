[
  {
    "label": "gpp",
    "command": "gpp",
    "cwd": "$ZED_DIRNAME",
    "reveal": "always",
    "use_new_terminal": false
  },
  {
    "label": "gl",
    "command": "gl",
    "args": ["$ZED_FILE"],
    "use_new_terminal": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "git-pull-all",
    "command": "gpa",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false
  },
  {
    "label": "git-pull",
    "command": "g",
    "cwd": "$ZED_DIRNAME",
    "reveal": "always",
    "use_new_terminal": false
  }
]

