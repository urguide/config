[Unit]
Description=Rclone 14tb
Wants=network-online.target
After=network-online.target

[Service]
Restart=always
ExecStart=/usr/bin/rclone mount \
--log-file /tmp/rclone-14tb.log \
pi_14tb:/mnt/14tb/mount  /home/tom/14tb
ExecStop=/bin/fusermount -uz /home/tom/14tb
Type=notify

[Install]
WantedBy=default.target
