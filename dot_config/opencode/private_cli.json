{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "file:///home/tom/.config/opencode/plugins/orca-opencode-status-tui/tui.js"
  ],
  "theme": {
    "name": "opencode",
    "mode": "dark"
  },
  "animations": false,
  "keybinds": {
    "session.first": "ctrl+g,alt+home",
    "session.last": "ctrl+alt+g",
    "input.buffer.home": "home",
    "input.buffer.end": "end"
  },
  "terminal": {
    "copy": "select"
  },
  "tabs": {
    "mode": "off",
    "layout": "horizontal"
  }
}
