{
  "$schema": "https://opencode.ai/config.json",
  "model": "myprovider/gpt-6-astra(max)",
  "permissions": [
    { "action": "external_directory", "resource": "~", "effect": "allow" },
    { "action": "external_directory", "resource": "~/**", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "../*", "effect": "ask" }
  ],
  "compaction": {
    "auto": true,
    "buffer": 20000
  },
  "providers": {
    "myprovider": {
      "name": "mymymy",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8317/v1",
        "apiKey": "{env:MY_CLI_PROXY_KEY}"
      },
      "models": {
        "grok-4.7(max)": {
          "name": "grok(max)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 500000, "output": 500000 }
        },
        "gpt-6-luna": {
          "name": "gpt-luna",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-6.1-terra": {
          "name": "gpt-terra",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-6.1-sol(max)": {
          "name": "gpt-sol(max)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-6-astra": {
          "name": "gpt-astra",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-6-astra(max)": {
          "name": "gpt-astra(max)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "claude-sonnet-5-5(max)": {
          "name": "sonnet(max)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-fable-5-1": {
          "name": "fable",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-opus-5-5(max)": {
          "name": "opus(max)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-mythos-5-2(max)": {
          "name": "mythos(max)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "kimi-k3(max)": {
          "name": "kimi-k3(max)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 131072 }
        },
        "gemini-3.8-flash-high(max)": {
          "name": "gemini-flash-high",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 65536 }
        },
        "gemini-4-argon-high(max)": {
          "name": "gemini-argon",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 65536 }
        },
        "claude-opus-5-5-high(max)": {
          "name": "gemini-opus(max)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 }
        }
      }
    },
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "qwen3.8:27b"
        }
      }
    },
    "proxy-pools": {
      "name": "CLIProxy 模型池",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:MY_CLI_PROXY_KEY}"
      },
      "models": {
        "antigravity-pool": {
          "name": "Antigravity Pool（2 模型）"
        },
        "all-pool": {
          "name": "All Pool（5 模型）"
        },
        "native-pool": {
          "name": "Native Pool（4 模型）"
        }
      }
    }
  },
  "agents": {
    "explore": { "model": "myprovider/grok-4.7(max)" },
    "general": { "model": "myprovider/grok-4.7(max)" }
  },
  "mcp": {
    "servers": {
      "blender": {
        "type": "local",
        "command": ["uvx", "mcp-for-blender"],
        "environment": {
          "BLENDER_HOST": "10.1.1.8",
          "BLENDER_PORT": "9876",
          "BLENDER_MCP_SAFE_MODE": "1"
        }
      }
    }
  }
}
