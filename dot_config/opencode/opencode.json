{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "mymymy",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "apiKey": "{env:MY_CLI_PROXY_KEY}"
      },
      "models": {
        "grok-4.7(max)": {
          "name": "grok(max)"
        },
        "gpt-6-luna": {
          "name": "gpt-luna"
        },
        "gpt-6-terra": {
          "name": "gpt-terra"
        },
        "gpt-6.1-sol(max)": {
          "name": "gpt-sol(max)"
        },
        "gpt-6-astra": {
          "name": "gpt-astra"
        },
        "gpt-6-astra(max)": {
          "name": "gpt-astra(max)"
        },
        "claude-sonnet-5-5(max)": {
          "name": "sonnet(max)"
        },
        "claude-fable-5-1": {
          "name": "fable"
        },
        "claude-opus-5-5(max)": {
          "name": "opus(max)"
        },
        "kimi-k3(max)": {
          "name": "kimi-k3(max)"
        },
        "gemini-3.8-flash-high": {
          "name": "gemini-flash-high"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "qwen3.8:27b"
        }
      }
    }
  },
  "agent": {
    "explore": { "model": "mymymy/grok-4.7" },
    "general": { "model": "mymymy/grok-4.7" }
  }
}
