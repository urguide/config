{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "mymymy",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "apiKey": "{env:MY_CLI_PROXY_KEY}"
      },
      "models": {
        "grok-4.5": {
          "name": "grok-4.5"
        },
        "gpt-5.6-luna": {
          "name": "gpt-5.6-luna"
        },
        "gpt-5.6-terra": {
          "name": "gpt-5.6-terra"
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol"
        },
        "claude-sonnet-5": {
          "name": "sonnet-5"
        },
        "claude-fable-5": {
          "name": "fable-5"
        },
        "claude-opus-4-8": {
          "name": "opus-4-8"
        },
        "claude-opus-5": {
          "name": "opus-5"
        },
        "claude-haiku-4-5-20251001": {
          "name": "haiku-4-5-20251001"
        },
        "gemini-3.1-pro-low": {
          "name": "gemini-3.1-pro-low"
        },
        "gemini-3.5-flash-low": {
          "name": "gemini-3.5-flash-low"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",

      "_script/wg_key*/**": "deny",
      "_script/rd_sshkey/**": "deny",
      "_script/_build_gcp_project/**/*-key.json": "deny",
      "_script/add_secret_centre-config.yaml": "deny",
      "istio_scg/certs/**": "deny",
      "istio_scg/secret-istio.yaml": "deny",
      "headscale/data/**": "deny",

      "pro/envcheck/**": "deny",
      "pro/*secret*.yaml": "deny",
      "pro/docker-pull-cred.yaml": "deny",
      "pro/additional-scrape-configs*.yaml": "deny",
      "pro/temp.yaml": "deny",
      "pro/diff/**": "deny",
      "3.shell_script/single-dev-k8s/*.yaml": "deny",

      "*.pem": "deny",
      "*.p12": "deny",
      "*private*.key": "deny",
      "config": "deny",
      "*/ssh/config": "deny",
      "2.myexe/ssh_list/config": "deny",

      ".kilo/worktrees/**": "deny",
      ".kilocode/**": "deny"
    },

    "edit": {
      "*": "allow",
      "1.project-list": "ask",
      "pro/**": "ask",
      "2.myexe/**": "ask",
      "update_version/**": "ask",
      "cp_to_usr_bin.sh": "ask",
      "7.crontab/**": "ask",
      "home_use_crontab/**": "ask",

      "_script/wg_key*/**": "deny",
      "_script/rd_sshkey/**": "deny",
      "_script/_build_gcp_project/**/*-key.json": "deny",
      "istio_scg/certs/**": "deny",
      "headscale/data/**": "deny",
      "pro/envcheck/**": "deny",
      "pro/*secret*.yaml": "deny",
      "*.env": "deny",
      "*.pem": "deny",
      ".kilo/worktrees/**": "deny",
      ".kilocode/**": "deny"
    },

    "bash": {
      "*": "allow",

      "kubectl apply *": "ask",
      "kubectl create *": "ask",
      "kubectl delete *": "ask",
      "kubectl scale *": "ask",
      "kubectl patch *": "ask",
      "kubectl set *": "ask",
      "kubectl edit *": "ask",
      "kubectl rollout *": "ask",
      "kubectl exec *": "ask",
      "kubectl cp *": "ask",
      "kubectl taint *": "ask",
      "kubectl drain *": "ask",
      "kubectl cordon *": "ask",
      "kubectl * apply *": "ask",
      "kubectl * delete *": "ask",
      "kubectl * scale *": "ask",
      "kubectl * patch *": "ask",
      "kubectl * exec *": "ask",

      "helm install *": "ask",
      "helm upgrade *": "ask",
      "helm uninstall *": "ask",
      "helm rollback *": "ask",
      "helm delete *": "ask",

      "gcloud config set *": "ask",
      "gcloud * delete *": "ask",
      "gcloud * remove-iam-policy-binding *": "ask",
      "gcloud * add-iam-policy-binding *": "ask",
      "gcloud * set-iam-policy *": "ask",
      "gcloud iam *": "ask",
      "gcloud services enable *": "ask",
      "gcloud services disable *": "ask",
      "gcloud compute ssh *": "ask",

      "gsutil rm *": "ask",
      "gsutil * rm *": "ask",
      "gsutil acl *": "ask",
      "gsutil iam *": "ask",
      "gsutil mv *": "ask",
      "gsutil rsync *": "ask",

      "argocd app sync *": "ask",
      "argocd app delete *": "ask",
      "argocd app set *": "ask",

      "docker push *": "ask",
      "./cp_to_usr_bin.sh*": "ask",
      "bash cp_to_usr_bin.sh*": "ask",

      "gcloud container clusters delete *": "deny",
      "gcloud projects delete *": "deny",
      "rm -rf /*": "deny",
      "git push *": "ask",
      "git commit *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",

      "cat *.env": "deny",
      "cat *.pem": "deny",
      "cat _script/wg_key*": "deny",
      "cat _script/rd_sshkey*": "deny",
      "* _script/wg_key/config/*": "deny",
      "* _script/rd_sshkey/*": "deny",
      "* pro/envcheck/*": "deny",
      "env": "deny",
      "printenv*": "deny"
    },

    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.kube/**": "ask",
      "~/.config/gcloud/**": "deny",
      "~/.ssh/**": "deny",
      "/usr/bin/**": "ask",
      "/usr/local/bin/**": "ask"
    },

    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask"
  },

  "agent": {
    "plan": {
      "permission": {
        "bash": {
          "*": "allow",
          "kubectl apply *": "deny",
          "kubectl create *": "deny",
          "kubectl delete *": "deny",
          "kubectl scale *": "deny",
          "kubectl patch *": "deny",
          "kubectl * apply *": "deny",
          "kubectl * delete *": "deny",
          "kubectl * scale *": "deny",
          "helm install *": "deny",
          "helm upgrade *": "deny",
          "helm uninstall *": "deny",
          "gcloud * delete *": "deny",
          "gcloud config set *": "deny",
          "gsutil rm *": "deny",
          "gsutil * rm *": "deny",
          "argocd app sync *": "deny",
          "docker push *": "deny",
          "git push *": "deny"
        }
      }
    }
  }
}
