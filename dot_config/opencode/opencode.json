{
  "$schema": "https://opencode.ai/config.json",
  "model": "myprovider/gpt-6-astra(max)",
  "permission": {
    "external_directory": {
      "~": "allow",
      "~/**": "allow"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "allow",
      "../*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "mymymy",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "apiKey": "{env:MY_CLI_PROXY_KEY}"
      },
      "models": {
        "grok-4.7(max)": {
          "name": "grok(max)"
        },
        "gpt-6-luna": {
          "name": "gpt-luna"
        },
        "gpt-6-terra": {
          "name": "gpt-terra"
        },
        "gpt-6.1-sol(max)": {
          "name": "gpt-sol(max)"
        },
        "gpt-6-astra": {
          "name": "gpt-astra",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-6-astra(max)": {
          "name": "gpt-astra(max)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-sonnet-5-5(max)": {
          "name": "sonnet(max)"
        },
        "claude-fable-5-1": {
          "name": "fable"
        },
        "claude-opus-5-5(max)": {
          "name": "opus(max)"
        },
        "kimi-k3(max)": {
          "name": "kimi-k3(max)"
        },
        "gemini-3.8-flash-high": {
          "name": "gemini-flash-high"
        },
        "gemini-4-argon-high": {
          "name": "gemini-argon",
          "attachment": true,
          "modalities": {
                "input": ["text", "image"],
                "output": ["text"]
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "qwen3.8:27b"
        }
      }
    }
  },
  "providers": {
    "proxy-pools": {
      "name": "CLIProxy 模型池",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:MY_CLI_PROXY_KEY}"
      },
      "models": {
        "antigravity-pool": {
          "name": "Antigravity Pool（2 模型）"
        },
        "all-pool": {
          "name": "All Pool（5 模型）"
        },
        "native-pool": {
          "name": "Native Pool（4 模型）"
        }
      }
    }
  },
  "agent": {
    "explore": { "model": "myprovider/grok-4.7(max)" },
    "general": { "model": "myprovider/grok-4.7(max)" }
  },
  "mcp": {
    "blender": {
      "type": "local",
      "command": ["uvx", "mcp-for-blender"],
      "enabled": true,
      "environment": {
        "BLENDER_HOST": "10.1.1.8",
        "BLENDER_PORT": "9876",
        "BLENDER_MCP_SAFE_MODE": "1"
      }
    }
  }
}
