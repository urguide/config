{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "mymymy",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "apiKey": "{env:MY_CLI_PROXY_KEY}"
      },
      "models": {
        "grok-4.7(max)": {
          "name": "grok-4.7(max)"
        },
        "gpt-5.6-luna": {
          "name": "gpt-6-luna"
        },
        "gpt-5.6-terra": {
          "name": "gpt-6-terra"
        },
        "gpt-5.6-sol(max)": {
          "name": "gpt-6-sol(max)"
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra"
        },
        "gpt-6-astra(max)": {
          "name": "gpt-6-astra(max)"
        },
        "claude-sonnet-5.5(max)": {
          "name": "sonnet-5.5(max)"
        },
        "claude-fable-5.1": {
          "name": "fable-5.1"
        },
        "claude-opus-5.5(max)": {
          "name": "opus-5.5(max)"
        },
        "gemini-3.8-flash-high": {
          "name": "gemini-3.8-flash-high"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "qwen3.8:27b"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",

      "_script/wg_key*/**": "deny",
      "_script/rd_sshkey/**": "deny",
      "_script/_build_gcp_project/**/*-key.json": "deny",
      "_script/add_secret_centre-config.yaml": "deny",
      "istio_scg/certs/**": "deny",
      "istio_scg/secret-istio.yaml": "deny",
      "headscale/data/**": "deny",

      "pro/envcheck/**": "deny",
      "pro/*secret*.yaml": "deny",
      "pro/docker-pull-cred.yaml": "deny",
      "pro/additional-scrape-configs*.yaml": "deny",
      "pro/temp.yaml": "deny",
      "pro/diff/**": "deny",
      "3.shell_script/single-dev-k8s/*.yaml": "deny",

      "*.pem": "deny",
      "*.p12": "deny",
      "*private*.key": "deny",
      "config": "deny",
      "*/ssh/config": "deny",
      "2.myexe/ssh_list/config": "deny",

      ".kilo/worktrees/**": "deny",
      ".kilocode/**": "deny"
    },

    "edit": {
      "*": "allow",
      "/etc/**": "ask",
      "/usr/**": "ask",
      "/boot/**": "ask",

      "_script/wg_key*/**": "deny",
      "_script/rd_sshkey/**": "deny",
      "_script/_build_gcp_project/**/*-key.json": "deny",
      "istio_scg/certs/**": "deny",
      "headscale/data/**": "deny",
      "pro/envcheck/**": "deny",
      "pro/*secret*.yaml": "deny",
      "*.env": "deny",
      "*.pem": "deny",
      ".kilo/worktrees/**": "deny",
      ".kilocode/**": "deny"
    },

    "bash": {
      "*": "allow",

      "kubectl apply *": "ask",
      "kubectl create *": "ask",
      "kubectl delete *": "ask",
      "kubectl scale *": "ask",
      "kubectl patch *": "ask",
      "kubectl set *": "ask",
      "kubectl edit *": "ask",
      "kubectl rollout *": "ask",
      "kubectl rollout status *": "allow",
      "kubectl rollout history *": "allow",
      "kubectl exec *": "ask",
      "kubectl cp *": "ask",
      "kubectl taint *": "ask",
      "kubectl drain *": "ask",
      "kubectl cordon *": "ask",
      "kubectl * apply *": "ask",
      "kubectl * delete *": "ask",
      "kubectl * scale *": "ask",
      "kubectl * patch *": "ask",
      "kubectl * exec *": "ask",

      "helm install *": "ask",
      "helm upgrade *": "ask",
      "helm uninstall *": "ask",
      "helm rollback *": "ask",
      "helm delete *": "ask",

      "gcloud * delete *": "ask",
      "gcloud * remove-iam-policy-binding *": "ask",
      "gcloud * add-iam-policy-binding *": "ask",
      "gcloud * set-iam-policy *": "ask",
      "gcloud iam *": "ask",
      "gcloud iam * list*": "allow",
      "gcloud iam * describe *": "allow",
      "gcloud iam * get-iam-policy *": "allow",
      "gcloud services enable *": "ask",
      "gcloud services disable *": "ask",
      "gcloud compute ssh *": "ask",

      "gsutil rm *": "ask",
      "gsutil * rm *": "ask",
      "gsutil acl *": "ask",
      "gsutil iam *": "ask",
      "gsutil acl get *": "allow",
      "gsutil iam get *": "allow",
      "gsutil mv *": "ask",
      "gsutil rsync *": "ask",

      "argocd app sync *": "ask",
      "argocd app delete *": "ask",
      "argocd app set *": "ask",

      "docker push *": "ask",
      "./cp_to_usr_bin.sh*": "ask",
      "bash cp_to_usr_bin.sh*": "ask",

      "sudo *": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "git push *--force*": "ask",
      "git push *-f*": "ask",
      "git push *+*": "ask",
      "git push *--delete*": "ask",
      "git push *-d *": "ask",
      "git push *:*": "ask",
      "git push *--mirror*": "ask",
      "git commit *--amend*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git checkout *-- *": "ask",
      "git restore *": "ask",

      "gcloud container clusters delete *": "deny",
      "gcloud projects delete *": "deny",
      "rm -rf /*": "deny",

      "cat *.env": "deny",
      "cat *.pem": "deny",
      "cat _script/wg_key*": "deny",
      "cat _script/rd_sshkey*": "deny",
      "* _script/wg_key/config/*": "deny",
      "* _script/rd_sshkey/*": "deny",
      "* pro/envcheck/*": "deny",
      "env": "deny",
      "printenv*": "deny"
    },

    "external_directory": {
      "*": "allow",
      "~/.kube/**": "ask",
      "~/.config/gcloud/**": "deny",
      "~/.ssh/**": "deny"
    },

    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask"
  },

  "agent": {
    "explore": { "model": "mymymy/grok-4.7" },
    "general": { "model": "mymymy/grok-4.7" },
    "plan": {
      "permission": {
        "bash": {
          "*": "allow",
          "kubectl apply *": "deny",
          "kubectl create *": "deny",
          "kubectl delete *": "deny",
          "kubectl scale *": "deny",
          "kubectl patch *": "deny",
          "kubectl * apply *": "deny",
          "kubectl * delete *": "deny",
          "kubectl * scale *": "deny",
          "helm install *": "deny",
          "helm upgrade *": "deny",
          "helm uninstall *": "deny",
          "gcloud * delete *": "deny",
          "gcloud config set *": "deny",
          "gsutil rm *": "deny",
          "gsutil * rm *": "deny",
          "argocd app sync *": "deny",
          "docker push *": "deny",
          "git push *": "deny"
        }
      }
    }
  }
}
