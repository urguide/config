# 同一台主機、同一帳號的 Bash 共用 ssh-agent
export SSH_AUTH_SOCK="$HOME/.ssh/agent/agent.sock"
unset SSH_AGENT_PID

(
    umask 077
    mkdir -p "$HOME/.ssh/agent" || exit
    chmod 700 "$HOME/.ssh/agent" || exit

    # 避免多個 shell 同時啟動 agent
    exec 9>"$HOME/.ssh/agent/agent.lock" || exit
    flock -x 9 || exit

    # 0：有金鑰；1：沒有金鑰；2：無法連線
    agent_status=0
    ssh-add -l >/dev/null 2>&1 || agent_status=$?

    if (( agent_status > 1 )); then
        # 清除失效的 socket，再用相同路徑啟動 agent
        rm -f -- "$SSH_AUTH_SOCK" || exit
        ssh-agent -a "$SSH_AUTH_SOCK" -s 9>&- >/dev/null
    fi
)

