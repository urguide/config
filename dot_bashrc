##提醒時鐘  ding 10m 提醒文字
##或是用精準時間  ding 14:08 提醒文字
ding() {
    local input=$1
    local msg=${2:-"時間到！"} # 如果沒給第二個參數，預設顯示「時間到！」
    local sound="/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"

    # 定義執行動作：發通知 + 播聲音
    local action="notify-send '鬧鐘' '$msg' -u critical -t 0 -i alarm && paplay $sound"

    # 判斷格式
    if [[ $input =~ ^[0-9]+[smh]$ ]]; then
        # 格式如 5m, 10s, 1h -> 使用 sleep
        echo "已設定倒數計時：$input 後提醒您"
        (sleep $input && eval "$action") &
    elif [[ $input =~ ^[0-9]{1,2}:[0-9]{2}$ ]]; then
        # 格式如 14:00 -> 使用 at
        echo "$action" | at $input
        echo "已設定定時鬧鐘：將在 $input 提醒您"
    else
        echo "格式錯誤！請使用 5m (倒數) 或 14:00 (定時)"
        echo "範例：ding 5m '泡麵好了' 或 ding 15:30 '開會'"
    fi
}



##curl response time
ct() {
    while true;do printf "%.3fms\n" $(( $(curl -o /dev/null -s -w '%{time_total}' $1) * 1000 ));sleep 1;done
}

ct2() {
URL="$1"
[ "$2" != "" ] && RESOLVE="--resolve $2"

while true; do
curl -o /dev/null -s -w \
"DNS Resolve: %{time_namelookup}\n\
Client -> Server(TCP Established): %{time_connect}\n\
SSL Handshake Done: %{time_appconnect}\n\
Redirect Time: %{time_redirect}\n\
Wait: %{time_pretransfer}\n\
Server Respon(TTFB): %{time_starttransfer}\n\
Total time: %{time_total}\n
Speed: %{speed_download}\n" \
$RESOLVE "${URL}"
echo "========================"
sleep 1
done
}

ct3() {
URL="$1"
curl -s -o /dev/null -w "DNS 解析: %{time_namelookup}s\n建立連線: %{time_connect}s\nTLS 握手: %{time_appconnect}s\n開始傳輸: %{time_starttransfer}s\n--- \n總時間: %{time_total}s\n" $URL

}


