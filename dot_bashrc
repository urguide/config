pw() {
    local length=${1:-20}
    local mode=${2:-}                 # 第二參數給 nosym(或 n)就不放符號

    local sympool='_!@#$%^&*()+=-'    # - 放最後 → 才是字面減號
    local upper lower digit symbol guaranteed pool others password

    upper=$(tr -dc 'A-Z' < /dev/urandom | head -c1)
    lower=$(tr -dc 'a-z' < /dev/urandom | head -c1)
    digit=$(tr -dc '0-9' < /dev/urandom | head -c1)

    if [[ $mode == n* ]]; then
        pool='A-Za-z0-9'
        guaranteed="$upper$lower$digit"
    else
        symbol=$(tr -dc "$sympool" < /dev/urandom | head -c1)
        pool="A-Za-z0-9$sympool"
        guaranteed="$upper$lower$digit$symbol"
    fi

    # 防呆:length 不能小於必選字元數,否則 head -c 變負數會 hang 住
    if (( length < ${#guaranteed} )); then
        echo "length 至少要 ${#guaranteed}" >&2
        return 1
    fi

    others=$(tr -dc "$pool" < /dev/urandom | head -c $((length - ${#guaranteed})))
    password=$(printf '%s' "$guaranteed$others" \
        | fold -w1 | shuf --random-source=/dev/urandom | tr -d '\n')
    echo "$password" | tee /dev/tty | wl-copy -n --type text/plain
}

